root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning

# EF Core migrations and model snapshots are generated output (AGENTS.md) — never reformat them.
[**/Persistence/Migrations/*.cs]
generated_code = true
