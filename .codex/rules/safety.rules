# Defense in depth for commands that need to leave the sandbox. The hook covers
# option variants and compound commands; these rules make common direct forms
# visibly forbidden in Codex's approval UI.
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked by repository policy.",
    match = ["rm -rf /private/tmp/example"],
)

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "forbidden",
    justification = "Recursive forced deletion is blocked by repository policy.",
    match = ["rm -fr /private/tmp/example"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard resets are blocked by repository policy.",
    match = ["git reset --hard"],
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "forbidden",
    justification = "Forced cleaning is blocked by repository policy.",
    match = ["git clean -f"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force pushes are blocked by repository policy.",
    match = ["git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "forbidden",
    justification = "Force pushes are blocked by repository policy.",
    match = ["git push --force-with-lease origin main"],
)

prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "forbidden",
    justification = "Use an explicitly reviewed manual database-drop workflow.",
    match = ["dotnet ef database drop"],
)

prefix_rule(
    pattern = ["terraform", "destroy"],
    decision = "forbidden",
    justification = "Use an explicitly reviewed manual infrastructure workflow.",
    match = ["terraform destroy"],
)
