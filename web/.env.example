# Base URL of the API. Unset -> requests go to same-origin `/api`, which the Vite dev server
# proxies to the .NET host at http://localhost:5208 (see vite.config.ts) and a production reverse
# proxy should route to the API. Prefer same-origin: the refresh cookie is SameSite=Strict.
VITE_API_URL=

# MSW keeps mocking the feature data that has no backend yet (deals, calendar, ...). Authentication
# is NOT mocked: /api/auth/* always reaches the real backend (unhandled requests bypass MSW).
# Set to "disabled" to turn all mocks off.
VITE_API_MOCKING=enabled
