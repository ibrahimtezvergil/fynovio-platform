{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "AccessTokenMinutes": 10
    },
    "Session": {
      "RefreshIdleDays": 7,
      "RefreshAbsoluteDays": 30,
      "RefreshGraceSeconds": 5,
      "CookieName": "fynovio_rt",
      "CookiePath": "/auth",
      "AllowInsecureCookieInDevelopment": false,
      "RequireSessionClaim": true
    },
    "AllowedOrigins": [],
    "Password": {
      "MinLength": 12,
      "MaxLength": 128
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimiting": {
      "LoginPerMinute": 30,
      "RefreshPerMinute": 60,
      "ForgotPerHour": 20,
      "TokenPer15Minutes": 20,
      "PasswordPer15Minutes": 10,
      "PublicPerMinute": 120
    }
  }
}
