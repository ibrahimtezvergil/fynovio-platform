{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "AccessTokenMinutes": 10
    },
    "Session": {
      "RefreshIdleDays": 7,
      "RefreshAbsoluteDays": 30,
      "RefreshGraceSeconds": 5,
      "CookieName": "fynovio_rt",
      "CookiePath": "/auth",
      "AllowInsecureCookieInDevelopment": false,
      "RequireSessionClaim": true
    },
    "AllowedOrigins": [],
    "SelfRegistration": {
      "Enabled": false,
      "AcknowledgeUnverifiedEmail": false
    },
    "Tokens": {
      "InviteDays": 7,
      "PasswordResetMinutes": 30,
      "PasswordSetupHours": 24
    },
    "Password": {
      "MinLength": 12,
      "MaxLength": 128
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimiting": {
      "LoginPerMinute": 30,
      "RefreshPerMinute": 60,
      "ForgotPerHour": 20,
      "TokenPer15Minutes": 20,
      "PasswordPer15Minutes": 10,
      "PublicPerMinute": 120
    }
  },
  "Email": {
    "Smtp": {
      "Enabled": false,
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "no-reply@fynovio.local",
      "FromName": "Fynovio"
    }
  },
  "Bootstrap": {
    "Enabled": false
  }
}
